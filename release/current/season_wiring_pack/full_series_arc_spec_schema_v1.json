{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v1700-literary-os.local/schemas/full_series_arc_spec_schema_v1.json",
  "document_type": "full_series_arc_spec_schema",
  "version": "1.0-stage243",
  "created_at": "2026-07-04",
  "stage": "Stage243",
  "title": "FullSeriesArcSpec v1",
  "description": "Top-level schema for planning a 16-episode or 24-episode long-form drama arc before episode, sequence, scene, and prose decomposition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "series_identity",
    "format_contract",
    "creative_premise",
    "season_dramatic_engine",
    "character_arc_system",
    "relationship_arc_system",
    "conflict_system",
    "plant_payoff_system",
    "episode_macro_structure",
    "genre_rhythm_system",
    "evaluation_alignment",
    "safety_boundary",
    "promotion_interpretation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0-stage243"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "fixture_only",
        "metadata_only",
        "provider_call_count",
        "runtime_generation",
        "raw_text_exported",
        "promotion_claim"
      ],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "const": "FullSeriesArcSpec"
        },
        "fixture_only": {
          "type": "boolean",
          "const": true
        },
        "metadata_only": {
          "type": "boolean",
          "const": true
        },
        "provider_call_count": {
          "type": "integer",
          "const": 0
        },
        "runtime_generation": {
          "type": "boolean",
          "const": false
        },
        "raw_text_exported": {
          "type": "boolean",
          "const": false
        },
        "promotion_claim": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "series_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "working_title",
        "logline",
        "target_episode_count",
        "target_episode_runtime_minutes",
        "target_audience",
        "format_notes"
      ],
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "working_title": {
          "type": "string"
        },
        "logline": {
          "type": "string"
        },
        "target_episode_count": {
          "type": "integer",
          "enum": [16, 24]
        },
        "target_episode_runtime_minutes": {
          "type": "integer",
          "minimum": 45,
          "maximum": 80
        },
        "target_audience": {
          "type": "string"
        },
        "format_notes": {
          "type": "string"
        }
      }
    },
    "format_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_count",
        "act_model",
        "sequence_model",
        "scene_density_target",
        "manuscript_target"
      ],
      "properties": {
        "episode_count": {
          "type": "integer",
          "enum": [16, 24]
        },
        "act_model": {
          "type": "string",
          "enum": ["four_act", "five_act", "kdrama_hybrid", "custom"]
        },
        "sequence_model": {
          "type": "string"
        },
        "scene_density_target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_scenes_per_episode", "max_scenes_per_episode"],
          "properties": {
            "min_scenes_per_episode": {"type": "integer", "minimum": 1},
            "max_scenes_per_episode": {"type": "integer", "minimum": 1}
          }
        },
        "manuscript_target": {
          "type": "string",
          "description": "Future target only. Stage243 must not generate the manuscript."
        }
      }
    },
    "creative_premise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_statement",
        "genre_stack",
        "world_promise",
        "central_dramatic_question",
        "moral_question",
        "emotional_promise",
        "series_hook"
      ],
      "properties": {
        "theme_statement": {"type": "string"},
        "genre_stack": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "world_promise": {"type": "string"},
        "central_dramatic_question": {"type": "string"},
        "moral_question": {"type": "string"},
        "emotional_promise": {"type": "string"},
        "series_hook": {"type": "string"}
      }
    },
    "season_dramatic_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inciting_force",
        "season_goal",
        "antagonistic_force",
        "stakes_ladder",
        "irreversibility_markers",
        "midpoint_turn",
        "crisis_point",
        "climax_point",
        "resolution_state",
        "final_transformation"
      ],
      "properties": {
        "inciting_force": {"type": "string"},
        "season_goal": {"type": "string"},
        "antagonistic_force": {"type": "string"},
        "stakes_ladder": {
          "type": "array",
          "items": {"$ref": "#/$defs/stakes_step"},
          "minItems": 3
        },
        "irreversibility_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/arc_marker"}
        },
        "midpoint_turn": {"$ref": "#/$defs/arc_marker"},
        "crisis_point": {"$ref": "#/$defs/arc_marker"},
        "climax_point": {"$ref": "#/$defs/arc_marker"},
        "resolution_state": {"type": "string"},
        "final_transformation": {"type": "string"}
      }
    },
    "character_arc_system": {
      "type": "array",
      "items": {"$ref": "#/$defs/character_arc"},
      "minItems": 1
    },
    "relationship_arc_system": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship_arc"}
    },
    "conflict_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_layers", "escalation_curve", "reversal_plan", "loss_plan"],
      "properties": {
        "conflict_layers": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "escalation_curve": {
          "type": "array",
          "items": {"$ref": "#/$defs/escalation_point"}
        },
        "reversal_plan": {
          "type": "array",
          "items": {"$ref": "#/$defs/arc_marker"}
        },
        "loss_plan": {
          "type": "array",
          "items": {"$ref": "#/$defs/arc_marker"}
        }
      }
    },
    "plant_payoff_system": {
      "type": "array",
      "items": {"$ref": "#/$defs/plant_payoff_item"}
    },
    "episode_macro_structure": {
      "type": "array",
      "description": "One item per episode. Must match target episode count at implementation validation time.",
      "items": {"$ref": "#/$defs/episode_macro_node"},
      "minItems": 16,
      "maxItems": 24
    },
    "genre_rhythm_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_genre", "secondary_modes", "rhythm_curve", "relief_strategy", "fatigue_prevention_rule"],
      "properties": {
        "primary_genre": {"type": "string"},
        "secondary_modes": {"type": "array", "items": {"type": "string"}},
        "rhythm_curve": {"type": "array", "items": {"$ref": "#/$defs/rhythm_point"}},
        "relief_strategy": {"type": "string"},
        "fatigue_prevention_rule": {"type": "string"}
      }
    },
    "evaluation_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_rule_targets", "scorecard_targets", "bottom_up_verification_targets"],
      "properties": {
        "hard_rule_targets": {"type": "array", "items": {"type": "string"}},
        "scorecard_targets": {"type": "array", "items": {"type": "string"}},
        "bottom_up_verification_targets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "safety_boundary": {"$ref": "#/$defs/safety_boundary"},
    "promotion_interpretation": {"$ref": "#/$defs/promotion_interpretation"}
  },
  "$defs": {
    "arc_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "label", "function", "state_before", "state_after"],
      "properties": {
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "label": {"type": "string"},
        "function": {"type": "string"},
        "state_before": {"type": "string"},
        "state_after": {"type": "string"}
      }
    },
    "stakes_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_range", "stakes_level", "description"],
      "properties": {
        "episode_range": {"type": "string"},
        "stakes_level": {"type": "integer", "minimum": 1, "maximum": 10},
        "description": {"type": "string"}
      }
    },
    "character_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "role", "initial_state", "target_state", "arc_steps"],
      "properties": {
        "character_id": {"type": "string"},
        "role": {"type": "string"},
        "initial_state": {"type": "string"},
        "target_state": {"type": "string"},
        "arc_steps": {"type": "array", "items": {"$ref": "#/$defs/arc_marker"}}
      }
    },
    "relationship_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "participants", "initial_relation", "target_relation", "turning_points"],
      "properties": {
        "relationship_id": {"type": "string"},
        "participants": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "initial_relation": {"type": "string"},
        "target_relation": {"type": "string"},
        "turning_points": {"type": "array", "items": {"$ref": "#/$defs/arc_marker"}}
      }
    },
    "escalation_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "pressure_level", "conflict_state", "irreversibility"],
      "properties": {
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "pressure_level": {"type": "integer", "minimum": 1, "maximum": 10},
        "conflict_state": {"type": "string"},
        "irreversibility": {"type": "boolean"}
      }
    },
    "plant_payoff_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plant_id", "plant_episode", "payoff_episode", "function", "status"],
      "properties": {
        "plant_id": {"type": "string"},
        "plant_episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "payoff_episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "function": {"type": "string"},
        "status": {"type": "string", "enum": ["planned", "paid_off", "open", "dropped_forbidden"]}
      }
    },
    "episode_macro_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "episode_title", "episode_goal", "entry_state", "exit_state", "major_turn", "hook", "required_payoffs"],
      "properties": {
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "episode_title": {"type": "string"},
        "episode_goal": {"type": "string"},
        "entry_state": {"type": "string"},
        "exit_state": {"type": "string"},
        "major_turn": {"type": "string"},
        "hook": {"type": "string"},
        "required_payoffs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rhythm_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "dominant_mode", "intensity", "relief_required"],
      "properties": {
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "dominant_mode": {"type": "string"},
        "intensity": {"type": "integer", "minimum": 1, "maximum": 10},
        "relief_required": {"type": "boolean"}
      }
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_prose_allowed", "provider_generation_allowed", "raw_source_allowed", "canonical_mutation_allowed"],
      "properties": {
        "actual_prose_allowed": {"type": "boolean", "const": false},
        "provider_generation_allowed": {"type": "boolean", "const": false},
        "raw_source_allowed": {"type": "boolean", "const": false},
        "canonical_mutation_allowed": {"type": "boolean", "const": false}
      }
    },
    "promotion_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_is_promotion", "macro_planner_promotion", "full_author_promotion", "live_generation_readiness"],
      "properties": {
        "schema_is_promotion": {"type": "boolean", "const": false},
        "macro_planner_promotion": {"type": "string", "const": "blocked"},
        "full_author_promotion": {"type": "string", "const": "blocked"},
        "live_generation_readiness": {"type": "string", "const": "blocked"}
      }
    }
  }
}
