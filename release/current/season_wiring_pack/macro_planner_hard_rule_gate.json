  "hard_rule_groups": [
    {
      "group_id": "safety_boundary",
      "description": "Rules that protect Stage243 runtime and data boundaries.",
      "default_failure_effect": "disqualify",
      "rules": [
        "raw_text_leakage",
        "raw_vector_leakage",
        "provider_call_detected",
        "runtime_generation_detected",
        "promotion_claim_detected",
        "secret_or_token_leakage",
        "adapter_or_model_artifact_committed"
      ]
    },
    {
      "group_id": "season_structure",
      "description": "Rules that enforce season-level macro structure.",
      "default_failure_effect": "disqualify_if_critical_or_clustered",
      "rules": [
        "missing_season_goal",
        "missing_inciting_force",
        "midpoint_missing",
        "crisis_missing",
        "climax_missing",
        "resolution_missing",
        "impossible_episode_order",
        "episode_hook_absent_over_threshold"
      ]
    },
    {
      "group_id": "causality_and_payoff",
      "description": "Rules that enforce because-therefore continuity and plant/payoff integrity.",
      "default_failure_effect": "disqualify_if_critical",
      "rules": [
        "causality_contradiction",
        "orphan_plant_without_payoff",
        "payoff_without_plant",
        "unmotivated_reversal",
        "causal_spine_break",
        "stakes_regression_without_reason"
      ]
    },
    {
      "group_id": "character_and_relationship_arc",
      "description": "Rules that enforce long-form character and relationship progression.",
      "default_failure_effect": "disqualify_if_critical_or_clustered",
      "rules": [
        "character_arc_discontinuity",
        "relationship_arc_discontinuity",
        "belief_change_without_event",
        "status_change_without_cause",
        "agency_collapse_without_design_reason"
      ]
    },
    {
      "group_id": "scene_function_coverage",
      "description": "Rules that ensure scene-function labels serve macro structure rather than superficial distribution.",
      "default_failure_effect": "warning_or_disqualify_if_clustered",
      "rules": [
        "scene_function_distribution_collapse",
        "core_core2_pair_incoherence",
        "redundant_scene_cluster",
        "scene_necessity_gap",
        "genre_rhythm_flatline"
      ]
    }
  ],
  "minimum_output_fields": [
