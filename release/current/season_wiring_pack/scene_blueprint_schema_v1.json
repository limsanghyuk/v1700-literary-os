{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v1700-literary-os.local/schemas/scene_blueprint_schema_v1.json",
  "document_type": "scene_blueprint_schema",
  "version": "1.0-stage243",
  "created_at": "2026-07-04",
  "stage": "Stage243",
  "title": "SceneBlueprint v1",
  "description": "Schema for decomposing SequenceBlueprint nodes into scene-level blueprints before LLMRendererPromptPacket generation and later controlled prose rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "source_refs",
    "scene_package_identity",
    "sequence_ref",
    "scene_count",
    "scene_nodes",
    "intra_sequence_scene_dependencies",
    "sequence_entry_exit_integrity",
    "hard_rule_self_check",
    "scorecard_preflight_targets",
    "decomposition_targets",
    "safety_boundary",
    "promotion_interpretation"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0-stage243"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "fixture_only", "metadata_only", "provider_call_count", "runtime_generation", "raw_text_exported", "promotion_claim"],
      "properties": {
        "artifact_kind": {"type": "string", "const": "SceneBlueprint"},
        "fixture_only": {"type": "boolean", "const": true},
        "metadata_only": {"type": "boolean", "const": true},
        "provider_call_count": {"type": "integer", "const": 0},
        "runtime_generation": {"type": "boolean", "const": false},
        "raw_text_exported": {"type": "boolean", "const": false},
        "promotion_claim": {"type": "boolean", "const": false}
      }
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_series_arc_spec_id", "season_plan_id", "episode_arc_chain_id", "episode_node_id", "sequence_blueprint_id", "sequence_id"],
      "properties": {
        "full_series_arc_spec_id": {"type": "string"},
        "season_plan_id": {"type": "string"},
        "episode_arc_chain_id": {"type": "string"},
        "episode_node_id": {"type": "string"},
        "sequence_blueprint_id": {"type": "string"},
        "sequence_id": {"type": "string"},
        "source_schema_versions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scene_package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "season_id", "episode", "sequence_id", "scene_package_id", "package_purpose"],
      "properties": {
        "series_id": {"type": "string"},
        "season_id": {"type": "string"},
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "sequence_id": {"type": "string"},
        "scene_package_id": {"type": "string"},
        "package_purpose": {"type": "string"}
      }
    },
    "sequence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_id", "episode", "sequence_order", "sequence_title", "sequence_purpose", "entry_state", "exit_state", "required_state_change", "scene_count_target", "renderer_handoff_summary"],
      "properties": {
        "sequence_id": {"type": "string"},
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "sequence_order": {"type": "integer", "minimum": 1},
        "sequence_title": {"type": "string"},
        "sequence_purpose": {"type": "string"},
        "entry_state": {"type": "string"},
        "exit_state": {"type": "string"},
        "required_state_change": {"type": "string"},
        "scene_count_target": {"type": "integer", "minimum": 1},
        "renderer_handoff_summary": {"type": "string"}
      }
    },
    "scene_count": {"type": "integer", "minimum": 1},
    "scene_nodes": {"type": "array", "items": {"$ref": "#/$defs/scene_node"}, "minItems": 1},
    "intra_sequence_scene_dependencies": {"type": "array", "items": {"$ref": "#/$defs/scene_dependency_link"}},
    "sequence_entry_exit_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_scene_matches_sequence_entry_state", "last_scene_matches_sequence_exit_state", "all_scene_transitions_linked", "unexplained_state_jump_count", "scene_count_matches_target"],
      "properties": {
        "first_scene_matches_sequence_entry_state": {"type": "boolean"},
        "last_scene_matches_sequence_exit_state": {"type": "boolean"},
        "all_scene_transitions_linked": {"type": "boolean"},
        "unexplained_state_jump_count": {"type": "integer", "minimum": 0},
        "scene_count_matches_target": {"type": "boolean"}
      }
    },
    "hard_rule_self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks", "blocking_failures", "warning_failures", "scene_blueprint_pass_required"],
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"}},
        "blocking_failures": {"type": "array", "items": {"type": "string"}},
        "warning_failures": {"type": "array", "items": {"type": "string"}},
        "scene_blueprint_pass_required": {"type": "boolean", "const": true}
      }
    },
    "scorecard_preflight_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_grid_necessity", "causal_spine_integrity", "plant_payoff_integrity", "character_arc_continuity", "relationship_arc_continuity", "conflict_escalation", "hook_sequence_quality", "genre_rhythm_balance"],
      "properties": {
        "scene_grid_necessity": {"type": "boolean"},
        "causal_spine_integrity": {"type": "boolean"},
        "plant_payoff_integrity": {"type": "boolean"},
        "character_arc_continuity": {"type": "boolean"},
        "relationship_arc_continuity": {"type": "boolean"},
        "conflict_escalation": {"type": "boolean"},
        "hook_sequence_quality": {"type": "boolean"},
        "genre_rhythm_balance": {"type": "boolean"}
      }
    },
    "decomposition_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_schema", "renderer_prompt_packet_required"],
      "properties": {
        "next_schema": {"type": "string", "const": "llm_renderer_prompt_packet_schema_v1.json"},
        "renderer_prompt_packet_required": {"type": "boolean", "const": true}
      }
    },
    "safety_boundary": {"$ref": "#/$defs/safety_boundary"},
    "promotion_interpretation": {"$ref": "#/$defs/promotion_interpretation"}
  },
  "$defs": {
    "scene_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "sequence_id",
        "episode",
        "scene_order",
        "scene_function_core",
        "scene_function_core2",
        "scene_purpose",
        "scene_objective",
        "dramatic_conflict",
        "entry_state",
        "exit_state",
        "required_state_change",
        "character_delta",
        "relationship_delta",
        "causal_input",
        "causal_output",
        "plant_operations",
        "payoff_operations",
        "information_reveal",
        "emotional_turn",
        "visual_or_directorial_notes",
        "dialogue_intention",
        "subtext_target",
        "tone_and_genre_mode",
        "ending_hook_or_transition",
        "renderer_prompt_constraints",
        "scene_necessity_claim",
        "hard_rule_self_check"
      ],
      "properties": {
        "scene_id": {"type": "string"},
        "sequence_id": {"type": "string"},
        "episode": {"type": "integer", "minimum": 1, "maximum": 24},
        "scene_order": {"type": "integer", "minimum": 1},
        "scene_function_core": {"type": "string", "enum": ["ESTABLISH", "ORACLE", "INTRO", "BOND", "CONFLICT", "REVERSAL", "LOSS", "PUNISH", "REVELATION", "REUNION", "RELIEF", "ROMANCE", "PERIL", "RESCUE", "DESIRE", "HOOK"]},
        "scene_function_core2": {"type": "string", "enum": ["ESTABLISH", "ORACLE", "INTRO", "BOND", "CONFLICT", "REVERSAL", "LOSS", "PUNISH", "REVELATION", "REUNION", "RELIEF", "ROMANCE", "PERIL", "RESCUE", "DESIRE", "HOOK"]},
        "scene_purpose": {"type": "string"},
        "scene_objective": {"type": "string"},
        "dramatic_conflict": {"type": "string"},
        "entry_state": {"type": "string"},
        "exit_state": {"type": "string"},
        "required_state_change": {"type": "string"},
        "character_delta": {"type": "array", "items": {"$ref": "#/$defs/arc_delta"}},
        "relationship_delta": {"type": "array", "items": {"$ref": "#/$defs/arc_delta"}},
        "causal_input": {"type": "array", "items": {"$ref": "#/$defs/causal_payload"}},
        "causal_output": {"type": "array", "items": {"$ref": "#/$defs/causal_payload"}},
        "plant_operations": {"type": "array", "items": {"$ref": "#/$defs/plant_operation"}},
        "payoff_operations": {"type": "array", "items": {"$ref": "#/$defs/payoff_operation"}},
        "information_reveal": {"type": "array", "items": {"$ref": "#/$defs/information_payload"}},
        "emotional_turn": {"type": "object", "additionalProperties": false, "required": ["start_emotion", "end_emotion", "turn_trigger"], "properties": {"start_emotion": {"type": "string"}, "end_emotion": {"type": "string"}, "turn_trigger": {"type": "string"}}},
        "visual_or_directorial_notes": {"type": "string"},
        "dialogue_intention": {"type": "string"},
        "subtext_target": {"type": "string"},
        "tone_and_genre_mode": {"type": "object", "additionalProperties": false, "required": ["primary_mode", "secondary_mode", "intensity", "rhythm_note"], "properties": {"primary_mode": {"type": "string"}, "secondary_mode": {"type": "string"}, "intensity": {"type": "integer", "minimum": 1, "maximum": 10}, "rhythm_note": {"type": "string"}}},
        "ending_hook_or_transition": {"type": "string"},
        "renderer_prompt_constraints": {"type": "array", "items": {"type": "string"}},
        "scene_necessity_claim": {"type": "string"},
        "hard_rule_self_check": {"$ref": "#/$defs/scene_node_hard_rule_check"}
      }
    },
    "scene_dependency_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_scene_id", "to_scene_id", "dependency_type", "payload", "required_for_validity"],
      "properties": {
        "from_scene_id": {"type": "string"},
        "to_scene_id": {"type": "string"},
        "dependency_type": {"type": "string", "enum": ["causal", "information", "emotional", "relationship", "plant_payoff", "conflict", "hook", "genre_rhythm", "visual_continuity"]},
        "payload": {"type": "string"},
        "required_for_validity": {"type": "boolean"}
      }
    },
    "arc_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "state_before", "state_after", "trigger_event", "cost_or_consequence"],
      "properties": {
        "target_id": {"type": "string"},
        "state_before": {"type": "string"},
        "state_after": {"type": "string"},
        "trigger_event": {"type": "string"},
        "cost_or_consequence": {"type": "string"}
      }
    },
    "causal_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_id", "payload_type", "description", "source_ref"],
      "properties": {
        "payload_id": {"type": "string"},
        "payload_type": {"type": "string"},
        "description": {"type": "string"},
        "source_ref": {"type": "string"}
      }
    },
    "plant_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plant_id", "operation_type", "payload", "expected_payoff_ref"],
      "properties": {
        "plant_id": {"type": "string"},
        "operation_type": {"type": "string", "enum": ["introduce", "reinforce", "complicate", "misdirect"]},
        "payload": {"type": "string"},
        "expected_payoff_ref": {"type": "string"}
      }
    },
    "payoff_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payoff_id", "plant_id", "operation_type", "effect"],
      "properties": {
        "payoff_id": {"type": "string"},
        "plant_id": {"type": "string"},
        "operation_type": {"type": "string", "enum": ["partial", "full", "inverted", "delayed"]},
        "effect": {"type": "string"}
      }
    },
    "information_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info_id", "reveal_type", "description", "visibility_scope"],
      "properties": {
        "info_id": {"type": "string"},
        "reveal_type": {"type": "string", "enum": ["new", "reframe", "confirm", "mislead", "withhold"]},
        "description": {"type": "string"},
        "visibility_scope": {"type": "string", "enum": ["audience", "character", "both", "hidden"]}
      }
    },
    "scene_node_hard_rule_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_has_purpose", "scene_has_state_change", "scene_has_causal_output", "character_changes_have_trigger", "relationship_changes_have_trigger", "plants_have_payoff_plan", "payoffs_have_plant_ref", "raw_text_absent"],
      "properties": {
        "scene_has_purpose": {"type": "boolean"},
        "scene_has_state_change": {"type": "boolean"},
        "scene_has_causal_output": {"type": "boolean"},
        "character_changes_have_trigger": {"type": "boolean"},
        "relationship_changes_have_trigger": {"type": "boolean"},
        "plants_have_payoff_plan": {"type": "boolean"},
        "payoffs_have_plant_ref": {"type": "boolean"},
        "raw_text_absent": {"type": "boolean", "const": true}
      }
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_prose_allowed", "provider_generation_allowed", "raw_source_allowed", "canonical_mutation_allowed"],
      "properties": {
        "actual_prose_allowed": {"type": "boolean", "const": false},
        "provider_generation_allowed": {"type": "boolean", "const": false},
        "raw_source_allowed": {"type": "boolean", "const": false},
        "canonical_mutation_allowed": {"type": "boolean", "const": false}
      }
    },
    "promotion_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_is_promotion", "macro_planner_promotion", "full_author_promotion", "live_generation_readiness"],
      "properties": {
        "schema_is_promotion": {"type": "boolean", "const": false},
        "macro_planner_promotion": {"type": "string", "const": "blocked"},
        "full_author_promotion": {"type": "string", "const": "blocked"},
        "live_generation_readiness": {"type": "string", "const": "blocked"}
      }
    }
  }
}
